PORT=3000
WEB_ORIGIN=http://localhost:5173

# SurrealDB (see surreal.service ensureSchema)
SURREAL_URL=http://127.0.0.1:8818/rpc
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=hiverarchy
SURREAL_DB=main

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Local file uploads directory (relative to API process cwd); served at /media
MEDIA_UPLOAD_ROOT=uploads
# Vite dev: proxy /media to the API so images work at http://localhost:5173/media/...

# Optional: OpenAI embeddings (POST /api/ai/embed-post/:postId)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
